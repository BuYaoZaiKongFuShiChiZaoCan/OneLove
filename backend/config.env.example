# ========================================
# OneLove 项目环境变量配置示例
# ========================================

# 服务器配置
PORT=3000
NODE_ENV=development

# MongoDB Atlas 配置（示例占位，不含任何真实凭据）
# 请在部署平台后台设置 MONGODB_URI 环境变量
MONGODB_URI=

# JWT 配置
# JWT 配置（示例占位，请在部署平台后台设置）
JWT_SECRET=

# 其他配置
# 允许的跨域来源（示例）
CORS_ORIGIN=http://localhost:3000,http://localhost:5500