# OneLove 生产环境配置
NODE_ENV=production
PORT=2457

# 数据库开关：1=不连接 MongoDB（走内存模拟数据，启动立即完成）
# 集群 onelove.bepz2u0.mongodb.net 已不存在，连接会阻塞约 2 分钟；恢复集群后改回 0
DB_DISABLED=1

# MongoDB Atlas 连接
MONGODB_URI=mongodb+srv://OneLoveAdminQi:LG.2457_AtlasQiAdminOneLove@onelove.bepz2u0.mongodb.net/?retryWrites=true&w=majority&appName=OneLove

# JWT 配置
JWT_SECRET=OneLove_JWT_Secret_2024_Production_Key_For_Security
JWT_EXPIRES_IN=7d

# 加密配置
ENCRYPTION_KEY=OneLove_Encryption_Key_256_Bit_Production_2024
ENCRYPTION_IV=OneLove_IV_16_Bit

# CORS 配置
CORS_ORIGIN=https://onelove-app.vercel.app,https://onelove-app-git-main.vercel.app,https://onelove-app-git-develop.vercel.app

# 安全配置
BCRYPT_ROUNDS=12
SESSION_SECRET=OneLove_Session_Secret_Production_2024

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 备份配置
BACKUP_RETENTION_DAYS=30
MAX_BACKUP_SIZE_MB=100

# 性能配置
MAX_REQUEST_SIZE=10mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100 